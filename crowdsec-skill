#!/usr/bin/env bash
# crowdsec-skill — CrowdSec Sentinel for OpenClaw
# MIT License — Brett Moore (InfraForesight Ltd)
set -euo pipefail

SCRIPT_NAME="crowdsec-skill"
VERSION="1.5.0"
DEFAULT_BAN_DURATION="24h"
DEFAULT_REPORT_PERIOD="24h"
DEFAULT_LIMIT="20"
CROWDSEC_LOG="/var/log/crowdsec/crowdsec.log"
CROWDSEC_API_LOG="/var/log/crowdsec/crowdsec_api.log"
OPENCLAW_WHITELIST="/etc/crowdsec/parsers/s02-enrich/whitelist-openclaw.yaml"
AUTH_LOG="/var/log/auth.log"
SYSLOG="/var/log/syslog"
KERN_LOG="/var/log/kern.log"
LOGROTATE_CONF="/etc/logrotate.d/crowdsec-openclaw"

# Alert thresholds
FAILED_LOGIN_WARN=5
FAILED_LOGIN_CRIT=10
BAN_COUNT_WARN=20
LOG_RETENTION_DAYS=30

# --- helpers ---

die() { echo "ERROR: $*" >&2; exit 1; }

require_cscli() {
  command -v cscli >/dev/null 2>&1 || die "cscli not found — run '$SCRIPT_NAME install' first"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "This command requires root privileges"
}

detect_os() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "$ID"
  else
    die "Cannot detect OS — /etc/os-release not found"
  fi
}

json_output() {
  if [ "${OUTPUT_FORMAT:-text}" = "json" ]; then
    return 0
  fi
  return 1
}

# --- commands ---

cmd_status() {
  require_cscli

  local bans alerts
  bans=$(cscli decisions list -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    if data is None: data = []
    print(len(data))
except: print(0)
" 2>/dev/null || echo "0")

  alerts=$(cscli alerts list -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    if data is None: data = []
    from datetime import datetime, timedelta, timezone
    cutoff = datetime.now(timezone.utc) - timedelta(hours=1)
    recent = [a for a in data if datetime.fromisoformat(a.get('created_at','2000-01-01T00:00:00Z').replace('Z','+00:00')) > cutoff]
    print(len(recent))
except: print(0)
" 2>/dev/null || echo "0")

  local bouncer_ok
  bouncer_ok=$(systemctl is-active crowdsec-firewall-bouncer 2>/dev/null || echo "inactive")

  local crowdsec_ok
  crowdsec_ok=$(systemctl is-active crowdsec 2>/dev/null || echo "inactive")

  if json_output; then
    cat <<EOF
{"active_bans":$bans,"alerts_last_hour":$alerts,"crowdsec":"$crowdsec_ok","bouncer":"$bouncer_ok","version":"$VERSION"}
EOF
  else
    echo "=== CrowdSec Status ==="
    echo "Engine:           $crowdsec_ok"
    echo "Firewall bouncer: $bouncer_ok"
    echo "Active bans:      $bans"
    echo "Alerts (1h):      $alerts"
  fi
}

cmd_bans() {
  require_cscli
  local limit="${1:-$DEFAULT_LIMIT}"

  cscli decisions list -o json 2>/dev/null | python3 -c "
import sys, json
try:
    alerts = json.load(sys.stdin)
    if not alerts:
        print('No active bans.')
        sys.exit(0)
    decisions = []
    for alert in alerts:
        for d in alert.get('decisions', []) or []:
            d['_scenario'] = alert.get('scenario', d.get('scenario', ''))
            d['_source_ip'] = alert.get('source', {}).get('ip', d.get('value', '?'))
            decisions.append(d)
    if not decisions:
        print('No active bans.')
        sys.exit(0)
    decisions.sort(key=lambda x: x.get('id', 0), reverse=True)
    limit = int(sys.argv[1]) if len(sys.argv) > 1 else 20
    decisions = decisions[:limit]
    fmt = '{:<18} {:<8} {:<6} {:<12} {}'
    print(fmt.format('IP', 'Action', 'Origin', 'Expiry', 'Reason'))
    print('-' * 75)
    for d in decisions:
        ip = d.get('value', d.get('_source_ip', '?'))
        action = d.get('type', '?')
        origin = d.get('origin', '?')
        duration = d.get('duration', '?')
        if isinstance(duration, str):
            duration = duration.split('.')[0]
            if len(duration) > 11:
                duration = duration[:11]
        scenario = d.get('_scenario', d.get('scenario', ''))
        if scenario.startswith('crowdsecurity/'):
            scenario = scenario[14:]
        print(fmt.format(str(ip)[:17], str(action)[:7], str(origin)[:5], str(duration)[:11], str(scenario)[:40]))
except Exception as e:
    print(f'Error: {e}')
" "$limit" 2>/dev/null
}

cmd_alerts() {
  require_cscli
  local since="${1:-1h}"

  local since_flag="--since 24h"
  case "$since" in
    *h) since_flag="--since ${since%h}h" ;;
    *d) since_flag="--since $((${since%d} * 24))h" ;;
  esac

  cscli alerts list $since_flag -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    if not data:
        print('No alerts in the requested period.')
        sys.exit(0)
    fmt = '{:<20} {:<18} {:<8} {}'
    print(fmt.format('Time', 'Source', 'Events', 'Scenario'))
    print('-' * 80)
    for a in data[:30]:
        ts = a.get('created_at', '?')[:19].replace('T', ' ')
        source_ip = '?'
        if a.get('source'):
            source_ip = a['source'].get('ip', a['source'].get('value', '?'))
        events = str(a.get('events_count', '?'))
        scenario = a.get('scenario', '?')
        if scenario.startswith('crowdsecurity/'):
            scenario = scenario[14:]
        print(fmt.format(ts, str(source_ip)[:17], events, scenario))
except Exception as e:
    print(f'Error: {e}')
" 2>/dev/null
}

cmd_metrics() {
  require_cscli
  cscli metrics 2>&1
}

cmd_ban() {
  require_cscli
  local ip="${1:?Usage: $SCRIPT_NAME ban <ip> [duration] [reason]}"
  local duration="${2:-$DEFAULT_BAN_DURATION}"
  local reason="${3:-manual ban via openclaw}"

  if ! echo "$ip" | grep -qE '^[0-9a-fA-F.:]+(/[0-9]+)?$'; then
    die "Invalid IP address: $ip"
  fi

  cscli decisions add -i "$ip" -d "$duration" -R "$reason" -t ban 2>&1
  echo "Banned $ip for $duration — reason: $reason"
}

cmd_unban() {
  require_cscli
  local ip="${1:?Usage: $SCRIPT_NAME unban <ip>}"

  cscli decisions delete -i "$ip" 2>&1
  echo "Unbanned $ip"
}

cmd_report() {
  require_cscli
  local period="${1:-$DEFAULT_REPORT_PERIOD}"

  local hours
  case "$period" in
    *h) hours="${period%h}" ;;
    *d) hours="$((${period%d} * 24))" ;;
    *)  hours="24" ;;
  esac

  local total_bans

  total_bans=$(cscli decisions list -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(len(data) if data else 0)
except: print(0)
" 2>/dev/null || echo "0")

  echo "=== Security Report (last ${period}) ==="
  echo ""
  echo "Active bans: $total_bans"
  echo ""

  echo "--- Top Attackers ---"
  cscli alerts list --since "${hours}h" -o json 2>/dev/null | python3 -c "
import sys, json
from collections import Counter
try:
    data = json.load(sys.stdin)
    if not data:
        print('No attacks in this period.')
        sys.exit(0)
    ips = Counter()
    scenarios = Counter()
    for a in data:
        ip = '?'
        if a.get('source'):
            ip = a['source'].get('ip', a['source'].get('value', '?'))
        ips[ip] += 1
        s = a.get('scenario', '?')
        if s.startswith('crowdsecurity/'):
            s = s[14:]
        scenarios[s] += 1

    print(f'Total alerts: {len(data)}')
    print(f'Unique attackers: {len(ips)}')
    print()
    for ip, count in ips.most_common(10):
        print(f'  {ip:<18} {count} alerts')
    print()
    print('--- Scenarios Triggered ---')
    for scenario, count in scenarios.most_common(10):
        print(f'  {scenario:<30} {count} hits')
except Exception as e:
    print(f'Error: {e}')
" 2>/dev/null

  echo ""
  echo "--- Bouncer Health ---"
  local bouncer_status
  bouncer_status=$(systemctl is-active crowdsec-firewall-bouncer 2>/dev/null || echo "inactive")
  echo "Firewall bouncer: $bouncer_status"

  local engine_status
  engine_status=$(systemctl is-active crowdsec 2>/dev/null || echo "inactive")
  echo "CrowdSec engine:  $engine_status"
}

cmd_install() {
  require_root

  if command -v cscli >/dev/null 2>&1; then
    echo "CrowdSec is already installed: $(cscli version 2>/dev/null | head -1)"
    echo "Use '$SCRIPT_NAME upgrade' to update."
    return 0
  fi

  local os
  os=$(detect_os)
  echo "Installing CrowdSec on $os..."

  case "$os" in
    ubuntu|debian)
      curl -s https://install.crowdsec.net | bash
      apt-get update -qq
      apt-get install -y crowdsec crowdsec-firewall-bouncer-iptables
      ;;
    centos|rhel|rocky|almalinux|fedora)
      curl -s https://install.crowdsec.net | bash
      if command -v dnf >/dev/null 2>&1; then
        dnf install -y crowdsec crowdsec-firewall-bouncer-iptables
      else
        yum install -y crowdsec crowdsec-firewall-bouncer-iptables
      fi
      ;;
    *)
      die "Unsupported OS: $os — install CrowdSec manually: https://docs.crowdsec.net/docs/getting_started/install_crowdsec"
      ;;
  esac

  local api_key
  api_key=$(cscli bouncers add crowdsec-firewall-bouncer -o raw 2>/dev/null || true)
  if [ -n "$api_key" ] && [ -f /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml ]; then
    sed -i "s|\${API_KEY}|$api_key|g" /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml
    sed -i "s|api_key:.*|api_key: $api_key|g" /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml
  fi

  systemctl enable --now crowdsec
  systemctl enable --now crowdsec-firewall-bouncer

  cscli collections install crowdsecurity/sshd 2>/dev/null || true
  cscli collections install crowdsecurity/linux 2>/dev/null || true
  cscli collections install crowdsecurity/iptables 2>/dev/null || true
  cscli collections install crowdsecurity/linux-lpe 2>/dev/null || true
  systemctl reload crowdsec

  # Configure log rotation
  cmd_logging setup

  echo ""
  echo "=== CrowdSec installed ==="
  echo "Engine:  $(systemctl is-active crowdsec)"
  echo "Bouncer: $(systemctl is-active crowdsec-firewall-bouncer)"
  echo ""
  echo "Next steps:"
  echo "  $SCRIPT_NAME whitelist <your-ip>   # whitelist your IP"
  echo "  $SCRIPT_NAME collections           # see installed collections"
  echo "  $SCRIPT_NAME status                # check health"
  echo "  $SCRIPT_NAME logging setup         # configure log rotation"
}

cmd_upgrade() {
  require_root
  require_cscli

  echo "Upgrading CrowdSec..."
  local os
  os=$(detect_os)

  case "$os" in
    ubuntu|debian)
      apt-get update -qq && apt-get install --only-upgrade -y crowdsec crowdsec-firewall-bouncer-iptables
      ;;
    centos|rhel|rocky|almalinux|fedora)
      if command -v dnf >/dev/null 2>&1; then
        dnf upgrade -y crowdsec crowdsec-firewall-bouncer-iptables
      else
        yum update -y crowdsec crowdsec-firewall-bouncer-iptables
      fi
      ;;
    *)
      die "Unsupported OS: $os — upgrade manually"
      ;;
  esac

  cscli hub update 2>/dev/null
  cscli hub upgrade 2>/dev/null
  systemctl restart crowdsec
  systemctl restart crowdsec-firewall-bouncer

  echo ""
  echo "Upgraded. Engine: $(cscli version 2>/dev/null | head -1)"
}

cmd_collections() {
  require_cscli
  local subcmd="${1:-list}"

  case "$subcmd" in
    list)
      cscli collections list 2>&1
      ;;
    available)
      cscli collections list -a 2>&1
      ;;
    install)
      local name="${2:?Usage: $SCRIPT_NAME collections install <name>}"
      cscli collections install "$name" 2>&1
      systemctl reload crowdsec
      echo "Collection '$name' installed and loaded."
      ;;
    remove)
      local name="${2:?Usage: $SCRIPT_NAME collections remove <name>}"
      cscli collections remove "$name" 2>&1
      systemctl reload crowdsec
      echo "Collection '$name' removed."
      ;;
    *)
      die "Unknown subcommand: $subcmd — use list, available, install, or remove"
      ;;
  esac
}

cmd_whitelist() {
  require_root
  require_cscli

  local action="${1:?Usage: $SCRIPT_NAME whitelist <add|remove|list> [ip/cidr]}"

  local wl_file="$OPENCLAW_WHITELIST"

  case "$action" in
    list)
      if [ -f "$wl_file" ]; then
        echo "=== OpenClaw Whitelist ==="
        grep -E "^\s+-\s+\"" "$wl_file" 2>/dev/null | sed 's/.*"\(.*\)"/  \1/'
      else
        echo "No OpenClaw whitelist configured."
      fi
      ;;
    add)
      local entry="${2:?Usage: $SCRIPT_NAME whitelist add <ip-or-cidr>}"
      if [ ! -f "$wl_file" ]; then
        cat > "$wl_file" <<WLEOF
name: crowdsecurity/whitelist-openclaw
description: "OpenClaw managed whitelist"
whitelist:
  reason: "whitelisted via openclaw crowdsec-skill"
  ip:
    - "127.0.0.1"
    - "::1"
WLEOF
      fi
      if echo "$entry" | grep -q "/"; then
        if ! grep -q "^  cidr:" "$wl_file"; then
          echo "  cidr:" >> "$wl_file"
        fi
        echo "    - \"$entry\"" >> "$wl_file"
      else
        sed -i "/^  ip:/a\\    - \"$entry\"" "$wl_file"
      fi
      systemctl reload crowdsec
      echo "Whitelisted: $entry"
      ;;
    remove)
      local entry="${2:?Usage: $SCRIPT_NAME whitelist remove <ip-or-cidr>}"
      if [ -f "$wl_file" ]; then
        grep -v "\"$entry\"" "$wl_file" > "${wl_file}.tmp" && mv "${wl_file}.tmp" "$wl_file"
        systemctl reload crowdsec
        echo "Removed from whitelist: $entry"
      else
        echo "No whitelist file found."
      fi
      ;;
    *)
      die "Unknown action: $action — use add, remove, or list"
      ;;
  esac
}

cmd_services() {
  require_root

  local action="${1:?Usage: $SCRIPT_NAME services <start|stop|restart|health>}"

  case "$action" in
    start)
      systemctl start crowdsec && echo "CrowdSec engine: started"
      systemctl start crowdsec-firewall-bouncer && echo "Firewall bouncer: started"
      ;;
    stop)
      systemctl stop crowdsec-firewall-bouncer && echo "Firewall bouncer: stopped"
      systemctl stop crowdsec && echo "CrowdSec engine: stopped"
      ;;
    restart)
      systemctl restart crowdsec && echo "CrowdSec engine: restarted"
      systemctl restart crowdsec-firewall-bouncer && echo "Firewall bouncer: restarted"
      ;;
    health)
      echo "=== Service Health ==="
      echo "CrowdSec engine:  $(systemctl is-active crowdsec 2>/dev/null || echo inactive)"
      echo "Firewall bouncer: $(systemctl is-active crowdsec-firewall-bouncer 2>/dev/null || echo inactive)"
      echo ""
      echo "=== Bouncer Registration ==="
      cscli bouncers list 2>&1
      echo ""
      echo "=== Collections ==="
      cscli collections list 2>&1
      echo ""
      echo "=== Version ==="
      cscli version 2>&1
      ;;
    *)
      die "Unknown action: $action — use start, stop, restart, or health"
      ;;
  esac
}

cmd_firewall() {
  require_root

  local action="${1:-status}"
  local bouncer_type

  if systemctl is-active --quiet crowdsec-firewall-bouncer-iptables 2>/dev/null || \
     [ -f /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml ]; then
    bouncer_type="iptables"
  elif systemctl is-active --quiet crowdsec-firewall-bouncer-ufw 2>/dev/null; then
    bouncer_type="ufw"
  else
    bouncer_type="unknown"
  fi

  case "$action" in
    status)
      echo "=== Firewall Status ==="
      echo "Bouncer type: $bouncer_type"
      echo ""
      if [ "$bouncer_type" = "iptables" ]; then
        # CrowdSec uses ipset for bans, check both chain and ipset
        echo "--- iptables CrowdSec rules ---"
        iptables -L INPUT -n --line-numbers 2>/dev/null | grep -i "crowdsec\|match-set" || echo "No iptables rules (may use ipset directly)"
        echo ""
        echo "--- ipset blocklists ---"
        if command -v ipset >/dev/null 2>&1; then
          local ipv4_count=0 ipv6_count=0 setname
          # CrowdSec may use suffixed names (crowdsec-blacklists-0, -1, etc.)
          for setname in $(ipset list -n 2>/dev/null | grep "crowdsec-blacklists"); do
            local entries
            entries=$(ipset list "$setname" 2>/dev/null | grep "^Number of entries:" | awk '{print $NF}')
            ipv4_count=$((ipv4_count + ${entries:-0}))
          done
          for setname in $(ipset list -n 2>/dev/null | grep "crowdsec6-blacklists"); do
            local entries
            entries=$(ipset list "$setname" 2>/dev/null | grep "^Number of entries:" | awk '{print $NF}')
            ipv6_count=$((ipv6_count + ${entries:-0}))
          done
          echo "IPv4 blocked: $ipv4_count"
          echo "IPv6 blocked: $ipv6_count"
        else
          echo "ipset not available"
        fi
      elif [ "$bouncer_type" = "ufw" ]; then
        echo "--- UFW Rules ---"
        ufw status 2>/dev/null | grep -E "(DROP|REJECT)" | head -20 || echo "No UFW rules"
      fi
      ;;
    reload)
      echo "Reloading firewall bouncer..."
      systemctl reload crowdsec-firewall-bouncer
      echo "Reloaded."
      ;;
    flush)
      echo "Flushing all CrowdSec bans..."
      cscli decisions delete --all 2>&1
      if [ "$bouncer_type" = "iptables" ]; then
        iptables -F crowdsec 2>/dev/null || true
      fi
      echo "All bans cleared."
      ;;
    switch)
      local target="${2:-}"
      if [ -z "$target" ]; then
        echo "Usage: $SCRIPT_NAME firewall switch <iptables|ufw>"
        echo "Current: $bouncer_type"
        return 1
      fi
      echo "Switching to $target bouncer..."
      systemctl stop crowdsec-firewall-bouncer
      if [ "$target" = "ufw" ]; then
        apt-get install -y crowdsec-firewall-bouncer-ufw 2>/dev/null || true
        echo "Switched to UFW. Ensure UFW is enabled: ufw enable"
      else
        apt-get install -y crowdsec-firewall-bouncer-iptables 2>/dev/null || true
        echo "Switched to iptables."
      fi
      systemctl start crowdsec-firewall-bouncer
      ;;
    *)
      die "Unknown action: $action — use status, reload, flush, or switch"
      ;;
  esac
}

cmd_logs() {
  local action="${1:-recent}"
  local lines="${2:-20}"

  case "$action" in
    recent)
      echo "=== Recent CrowdSec Logs ==="
      if [ -f "$CROWDSEC_LOG" ]; then
        tail -n "$lines" "$CROWDSEC_LOG"
      else
        journalctl -u crowdsec -n "$lines" --no-pager 2>/dev/null || echo "No logs found"
      fi
      ;;
    errors)
      echo "=== Error Logs ==="
      if [ -f "$CROWDSEC_LOG" ]; then
        grep -iE "error|fatal|critical" "$CROWDSEC_LOG" | tail -n "$lines"
      else
        journalctl -u crowdsec -p err -n "$lines" --no-pager 2>/dev/null || echo "No errors found"
      fi
      ;;
    watch)
      echo "Watching logs (Ctrl+C to stop)..."
      if [ -f "$CROWDSEC_LOG" ]; then
        tail -f "$CROWDSEC_LOG"
      else
        journalctl -u crowdsec -f 2>/dev/null || echo "Cannot watch logs"
      fi
      ;;
    stats)
      echo "=== Log Statistics ==="
      if [ -f "$CROWDSEC_LOG" ]; then
        echo "Log file: $CROWDSEC_LOG"
        echo "Size: $(du -h "$CROWDSEC_LOG" | cut -f1)"
        echo "Lines: $(wc -l < "$CROWDSEC_LOG")"
        echo ""
        echo "Events today:"
        grep "$(date +%Y-%m-%d)" "$CROWDSEC_LOG" 2>/dev/null | wc -l || echo "0"
      else
        echo "Using journald"
        journalctl -u crowdsec --since today --no-pager | wc -l
      fi
      ;;
    *)
      die "Unknown action: $action — use recent, errors, watch, or stats"
      ;;
  esac
}

cmd_auth() {
  local action="${1:-recent}"
  local lines="${2:-20}"

  case "$action" in
    recent)
      echo "=== Recent Auth Events ==="
      if [ -f "$AUTH_LOG" ]; then
        tail -n "$lines" "$AUTH_LOG"
      else
        journalctl -t sshd -t sudo -t su -n "$lines" --no-pager 2>/dev/null || echo "No auth logs found"
      fi
      ;;
    failed)
      echo "=== Failed Login Attempts ==="
      local count=0
      if [ -f "$AUTH_LOG" ]; then
        count=$(grep -ciE "failed|failure|invalid" "$AUTH_LOG" 2>/dev/null || echo "0")
        echo "Total failed attempts in log: $count"
        echo ""
        echo "Last $lines failures:"
        grep -iE "failed|failure|invalid" "$AUTH_LOG" | tail -n "$lines"
      else
        journalctl -t sshd -p warning -n "$lines" --no-pager 2>/dev/null || echo "No failed logins found"
      fi
      ;;
    success)
      echo "=== Successful Logins ==="
      if [ -f "$AUTH_LOG" ]; then
        grep -i "accepted\|session opened" "$AUTH_LOG" | tail -n "$lines"
      else
        journalctl -t sshd | grep -i "accepted" | tail -n "$lines" 2>/dev/null || echo "No successful logins"
      fi
      ;;
    sudo)
      echo "=== Sudo Usage ==="
      if [ -f "$AUTH_LOG" ]; then
        grep "sudo:" "$AUTH_LOG" | tail -n "$lines"
      else
        journalctl -t sudo -n "$lines" --no-pager 2>/dev/null || echo "No sudo usage found"
      fi
      ;;
    stats)
      echo "=== Auth Log Statistics ==="
      if [ -f "$AUTH_LOG" ]; then
        echo "Log file: $AUTH_LOG"
        echo "Size: $(du -h "$AUTH_LOG" | cut -f1)"
        echo ""
        echo "Today's activity:"
        local today_iso today_syslog
        today_iso=$(date +%Y-%m-%d)
        today_syslog=$(date +"%b %_d")
        local failed_count success_count sudo_count
        failed_count=$(grep -E "$today_iso|$today_syslog" "$AUTH_LOG" 2>/dev/null | grep -ciE "failed|failure" || true)
        success_count=$(grep -E "$today_iso|$today_syslog" "$AUTH_LOG" 2>/dev/null | grep -ci "accepted" || true)
        sudo_count=$(grep -E "$today_iso|$today_syslog" "$AUTH_LOG" 2>/dev/null | grep -ci "sudo:" || true)
        echo "  Failed logins: ${failed_count:-0}"
        echo "  Successful: ${success_count:-0}"
        echo "  Sudo commands: ${sudo_count:-0}"
      else
        echo "Using journald"
        echo "  SSH events today: $(journalctl -t sshd --since today --no-pager 2>/dev/null | wc -l)"
      fi
      ;;
    *)
      die "Unknown action: $action — use recent, failed, success, sudo, or stats"
      ;;
  esac
}

cmd_syslog() {
  local action="${1:-recent}"
  local lines="${2:-20}"

  case "$action" in
    recent)
      echo "=== Recent Syslog Entries ==="
      if [ -f "$SYSLOG" ]; then
        tail -n "$lines" "$SYSLOG"
      else
        journalctl -n "$lines" --no-pager 2>/dev/null || echo "No syslog found"
      fi
      ;;
    errors)
      echo "=== Syslog Errors ==="
      if [ -f "$SYSLOG" ]; then
        grep -iE "error|critical|emergency|alert" "$SYSLOG" | tail -n "$lines"
      else
        journalctl -p err -n "$lines" --no-pager 2>/dev/null || echo "No errors found"
      fi
      ;;
    kernel)
      echo "=== Kernel Messages (dmesg) ==="
      if [ -f "$KERN_LOG" ]; then
        tail -n "$lines" "$KERN_LOG"
      else
        dmesg | tail -n "$lines" 2>/dev/null || journalctl -k -n "$lines" --no-pager 2>/dev/null || echo "No kernel logs"
      fi
      ;;
    security)
      echo "=== Security-Related Syslog ==="
      if [ -f "$SYSLOG" ]; then
        grep -iE "security|violation|unauthorized|attack|intrusion|crowdsec" "$SYSLOG" | tail -n "$lines"
      else
        journalctl | grep -iE "security|violation|unauthorized|attack|intrusion|crowdsec" | tail -n "$lines" 2>/dev/null || echo "No security events"
      fi
      ;;
    *)
      die "Unknown action: $action — use recent, errors, kernel, or security"
      ;;
  esac
}

cmd_alert() {
  require_cscli

  local check_type="${1:-all}"

  echo "=== Proactive Security Alert Check ==="
  echo "Timestamp: $(date -Iseconds)"
  echo ""

  local alerts_count=0
  local ban_count=0
  local failed_logins=0
  local service_status="OK"

  # Check active bans
  ban_count=$(cscli decisions list -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(len(data) if data else 0)
except: print(0)
" 2>/dev/null || echo "0")

  if [ "$ban_count" -ge "$BAN_COUNT_WARN" ]; then
    echo "⚠️  WARNING: High number of active bans ($ban_count)"
    alerts_count=$((alerts_count + 1))
  else
    echo "✓ Active bans: $ban_count (normal)"
  fi

  # Check recent alerts
  local recent_alerts
  recent_alerts=$(cscli alerts list --since 1h -o json 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(len(data) if data else 0)
except: print(0)
" 2>/dev/null || echo "0")

  if [ "$recent_alerts" -ge 10 ]; then
    echo "⚠️  WARNING: High alert activity ($recent_alerts alerts/hour)"
    alerts_count=$((alerts_count + 1))
  else
    echo "✓ Alerts (1h): $recent_alerts (normal)"
  fi

  # Check failed logins
  if [ -f "$AUTH_LOG" ]; then
    local today_iso today_syslog
    today_iso=$(date +%Y-%m-%d)
    today_syslog=$(date +"%b %_d")
    failed_logins=$(grep -E "$today_iso|$today_syslog" "$AUTH_LOG" 2>/dev/null | grep -ciE "failed|failure" || true)
    failed_logins="${failed_logins:-0}"
  else
    failed_logins=$(journalctl -t sshd --since today --no-pager 2>/dev/null | grep -ci "failed" || true)
    failed_logins="${failed_logins:-0}"
  fi

  if [ "$failed_logins" -ge "$FAILED_LOGIN_CRIT" ]; then
    echo "🚨 CRITICAL: High failed login attempts today ($failed_logins)"
    alerts_count=$((alerts_count + 2))
    service_status="CRITICAL"
  elif [ "$failed_logins" -ge "$FAILED_LOGIN_WARN" ]; then
    echo "⚠️  WARNING: Elevated failed logins ($failed_logins today)"
    alerts_count=$((alerts_count + 1))
  else
    echo "✓ Failed logins today: $failed_logins (normal)"
  fi

  # Check services
  local crowdsec_status
  crowdsec_status=$(systemctl is-active crowdsec 2>/dev/null || echo "inactive")
  if [ "$crowdsec_status" != "active" ]; then
    echo "🚨 CRITICAL: CrowdSec service is $crowdsec_status"
    alerts_count=$((alerts_count + 2))
    service_status="CRITICAL"
  else
    echo "✓ CrowdSec service: active"
  fi

  local bouncer_status
  bouncer_status=$(systemctl is-active crowdsec-firewall-bouncer 2>/dev/null || echo "inactive")
  if [ "$bouncer_status" != "active" ]; then
    echo "🚨 CRITICAL: Firewall bouncer is $bouncer_status"
    alerts_count=$((alerts_count + 2))
    service_status="CRITICAL"
  else
    echo "✓ Firewall bouncer: active"
  fi

  echo ""
  echo "=== Summary ==="
  if [ "$alerts_count" -eq 0 ]; then
    echo "Status: ALL CLEAR - No security issues detected"
    echo "OpenClaw: No alert needed"
  elif [ "$alerts_count" -le 2 ]; then
    echo "Status: WARNING - $alerts_count issue(s) detected"
    echo "OpenClaw: Send digest alert to user"
  else
    echo "Status: CRITICAL - Immediate attention required"
    echo "OpenClaw: Send immediate alert to user via WhatsApp"
  fi

  # Return code for automation
  if [ "$alerts_count" -gt 2 ]; then
    return 2
  elif [ "$alerts_count" -gt 0 ]; then
    return 1
  fi
  return 0
}

cmd_hardening() {
  require_root

  echo "=== VPA Security Hardening Check ==="
  echo "Timestamp: $(date -Iseconds)"
  echo ""

  local issues=0

  # Check SSH configuration
  echo "--- SSH Configuration ---"
  if [ -f /etc/ssh/sshd_config ]; then
    # Check effective SSH settings (include drop-in configs)
    local sshd_effective
    sshd_effective=$(sshd -T 2>/dev/null || cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null)

    if echo "$sshd_effective" | grep -qi "^permitrootlogin yes"; then
      echo "⚠️  Root login permitted via SSH"
      issues=$((issues + 1))
    elif echo "$sshd_effective" | grep -qi "^permitrootlogin prohibit-password"; then
      echo "✓ Root login: key-only (prohibit-password)"
    elif echo "$sshd_effective" | grep -qi "^permitrootlogin no"; then
      echo "✓ Root login: disabled"
    else
      echo "ℹ️  Root login: using default (prohibit-password)"
    fi

    if echo "$sshd_effective" | grep -qi "^passwordauthentication yes"; then
      echo "⚠️  Password authentication enabled (consider key-only)"
      issues=$((issues + 1))
    else
      echo "✓ Password authentication disabled"
    fi

    if echo "$sshd_effective" | grep -qi "^permitemptypasswords yes"; then
      echo "🚨 Empty passwords permitted!"
      issues=$((issues + 2))
    else
      echo "✓ Empty passwords disabled"
    fi
  else
    echo "ℹ️  SSH config not found (may use defaults)"
  fi

  # Check firewall
  echo ""
  echo "--- Firewall Status ---"
  if systemctl is-active --quiet ufw 2>/dev/null; then
    echo "✓ UFW firewall active"
  elif iptables -L INPUT -n 2>/dev/null | grep -q "ACCEPT"; then
    echo "✓ iptables rules present"
  else
    echo "⚠️  Firewall status unclear"
    issues=$((issues + 1))
  fi

  # Check for CrowdSec
  echo ""
  echo "--- Security Monitoring ---"
  if command -v cscli >/dev/null 2>&1; then
    echo "✓ CrowdSec installed"
  else
    echo "⚠️  CrowdSec not installed"
    issues=$((issues + 1))
  fi

  if systemctl is-active --quiet crowdsec 2>/dev/null; then
    echo "✓ CrowdSec service running"
  else
    echo "⚠️  CrowdSec service not running"
    issues=$((issues + 1))
  fi

  # Check fail2ban (should not run with CrowdSec)
  if systemctl is-active --quiet fail2ban 2>/dev/null; then
    echo "⚠️  Fail2ban running (conflicts with CrowdSec)"
    issues=$((issues + 1))
  else
    echo "✓ Fail2ban not running (good)"
  fi

  # Check automatic security updates
  echo ""
  echo "--- Updates ---"
  if dpkg -l | grep -q unattended-upgrades 2>/dev/null; then
    echo "✓ Unattended upgrades installed"
  else
    echo "⚠️  Unattended upgrades not installed"
    issues=$((issues + 1))
  fi

  # Check for world-writable files
  echo ""
  echo "--- File Permissions ---"
  local ww_count
  ww_count=$(find /etc -type f -perm -002 2>/dev/null | wc -l)
  if [ "$ww_count" -gt 0 ]; then
    echo "⚠️  $ww_count world-writable files in /etc"
    issues=$((issues + 1))
  else
    echo "✓ No world-writable files in /etc"
  fi

  echo ""
  echo "=== Summary ==="
  if [ "$issues" -eq 0 ]; then
    echo "Status: HARDENED - All security checks passed"
  elif [ "$issues" -le 2 ]; then
    echo "Status: NEEDS ATTENTION - $issues issue(s) found"
    echo "Recommendation: Run 'crowdsec-skill hardening --fix' for auto-fixes"
  else
    echo "Status: VULNERABLE - $issues security issues detected"
    echo "Recommendation: Address critical issues immediately"
  fi
}

cmd_logging() {
  require_root

  local action="${1:-status}"

  case "$action" in
    status)
      echo "=== Logging Configuration Status ==="
      echo ""
      echo "--- Log Files ---"
      if [ -f "$CROWDSEC_LOG" ]; then
        echo "CrowdSec log: $CROWDSEC_LOG ($(du -h "$CROWDSEC_LOG" | cut -f1))"
      else
        echo "CrowdSec log: Using journald"
      fi

      if [ -f "$CROWDSEC_API_LOG" ]; then
        echo "API log: $CROWDSEC_API_LOG ($(du -h "$CROWDSEC_API_LOG" | cut -f1))"
      fi

      echo ""
      echo "--- Log Rotation ---"
      if [ -f "$LOGROTATE_CONF" ]; then
        echo "Rotation config: $LOGROTATE_CONF"
        cat "$LOGROTATE_CONF"
      else
        echo "⚠️  No custom log rotation configured"
        echo "Recommendation: Run '$SCRIPT_NAME logging setup'"
      fi

      echo ""
      echo "--- Journald Settings ---"
      if [ -f /etc/systemd/journald.conf ]; then
        grep -E "^SystemMaxUse|^MaxRetentionSec" /etc/systemd/journald.conf 2>/dev/null || echo "Using defaults"
      fi
      ;;

    setup)
      echo "=== Setting Up Log Rotation ==="
      echo ""

      # Create logrotate configuration
      cat > "$LOGROTATE_CONF" << 'ROTATEEOF'
/var/log/crowdsec/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
    postrotate
        systemctl reload crowdsec > /dev/null 2>&1 || true
    endscript
}
ROTATEEOF

      chmod 644 "$LOGROTATE_CONF"
      echo "✓ Created log rotation config: $LOGROTATE_CONF"
      echo "  - Daily rotation"
      echo "  - Retain 30 days"
      echo "  - Compress old logs"
      echo "  - Reload CrowdSec after rotation"

      # Ensure log directory exists with correct permissions
      if [ ! -d /var/log/crowdsec ]; then
        mkdir -p /var/log/crowdsec
        chmod 755 /var/log/crowdsec
        echo "✓ Created log directory: /var/log/crowdsec"
      fi

      # Test logrotate config
      if command -v logrotate >/dev/null 2>&1; then
        logrotate -d "$LOGROTATE_CONF" 2>&1 | head -5 || true
        echo ""
        echo "✓ Log rotation configured successfully"
      else
        echo "⚠️  logrotate not installed, but config file created"
      fi
      ;;

    retention)
      local days="${2:-$LOG_RETENTION_DAYS}"
      echo "=== Log Retention Management ==="
      echo "Current retention setting: $days days"
      echo ""

      # Update logrotate config with new retention
      if [ -f "$LOGROTATE_CONF" ]; then
        sed -i "s/rotate [0-9]*/rotate $days/" "$LOGROTATE_CONF"
        echo "✓ Updated retention to $days days in $LOGROTATE_CONF"
      else
        echo "⚠️  No logrotate config found. Run '$SCRIPT_NAME logging setup' first."
      fi

      # Clean old logs immediately
      echo ""
      echo "Cleaning logs older than $days days..."
      if [ -d /var/log/crowdsec ]; then
        find /var/log/crowdsec -name "*.log.*" -mtime +"$days" -delete 2>/dev/null || true
        echo "✓ Old compressed logs cleaned"
      fi
      ;;

    report)
      local period="${2:-7d}"
      echo "=== Log Analysis Report ==="
      echo "Period: $period"
      echo "Generated: $(date -Iseconds)"
      echo ""

      local hours
      case "$period" in
        *h) hours="${period%h}" ;;
        *d) hours="$((${period%d} * 24))" ;;
        *)  hours="168" ;;
      esac

      echo "--- CrowdSec Activity ---"
      if [ -f "$CROWDSEC_LOG" ]; then
        local total_lines
        total_lines=$(wc -l < "$CROWDSEC_LOG")
        echo "Total log entries: $total_lines"

        local error_count
        error_count=$(grep -ciE "error|fatal|critical" "$CROWDSEC_LOG" 2>/dev/null || echo "0")
        echo "Error entries: $error_count"

        local ban_events
        ban_events=$(grep -c "ban\|decision" "$CROWDSEC_LOG" 2>/dev/null || echo "0")
        echo "Ban-related events: $ban_events"
      else
        echo "Using journald"
        echo "Entries (period): $(journalctl -u crowdsec --since "$hours hours ago" --no-pager | wc -l)"
      fi

      echo ""
      echo "--- Auth Log Summary ---"
      if [ -f "$AUTH_LOG" ]; then
        local failed_today
        failed_today=$(grep -c "$(date +%b.*$(date +%d)).*[Ff]ailed" "$AUTH_LOG" 2>/dev/null || echo "0")
        echo "Failed logins today: $failed_today"

        local success_today
        success_today=$(grep -c "$(date +%b.*$(date +%d)).*[Aa]ccepted" "$AUTH_LOG" 2>/dev/null || echo "0")
        echo "Successful logins today: $success_today"
      fi

      echo ""
      echo "--- Disk Usage ---"
      if [ -d /var/log/crowdsec ]; then
        echo "CrowdSec logs: $(du -sh /var/log/crowdsec 2>/dev/null | cut -f1)"
      fi
      echo "Auth log: $(du -h "$AUTH_LOG" 2>/dev/null | cut -f1 || echo "N/A")"
      echo "Syslog: $(du -h "$SYSLOG" 2>/dev/null | cut -f1 || echo "N/A")"
      ;;

    rotate)
      echo "=== Forcing Log Rotation ==="
      if command -v logrotate >/dev/null 2>&1; then
        logrotate -f "$LOGROTATE_CONF" 2>/dev/null && echo "✓ Logs rotated successfully" || echo "⚠️  Rotation failed"
      else
        echo "⚠️  logrotate not installed"
        echo "Manual rotation:"
        if [ -f "$CROWDSEC_LOG" ]; then
          mv "$CROWDSEC_LOG" "${CROWDSEC_LOG}.$(date +%Y%m%d%H%M%S)"
          touch "$CROWDSEC_LOG"
          chmod 0640 "$CROWDSEC_LOG"
          systemctl reload crowdsec
          echo "✓ Manual rotation completed"
        fi
      fi
      ;;

    *)
      die "Unknown action: $action — use status, setup, retention, report, or rotate"
      ;;
  esac
}

cmd_compare() {
  cat <<EOF
=== CrowdSec vs Fail2ban ===

CrowdSec is the modern, collaborative replacement for Fail2ban.

Key Advantages:

1. COLLABORATIVE THREAT INTELLIGENCE
   - Fail2ban: Local-only, protects only your server
   - CrowdSec: 50,000+ users share threat data globally
   - Impact: Attacker blocked by one user is blocked for all

2. BEHAVIORAL DETECTION
   - Fail2ban: Simple regex matching on log lines
   - CrowdSec: Scenario-based pattern analysis over time
   - Impact: Catches sophisticated attacks that regex misses

3. PERFORMANCE & SCALABILITY
   - Fail2ban: Python-based, struggles under high load
   - CrowdSec: Go-based engine, efficient concurrent processing
   - Impact: Handles DDoS and brute-force attacks without lag

4. CLOUD-NATIVE ARCHITECTURE
   - Fail2ban: Designed for bare-metal servers
   - CrowdSec: Built for Docker, Kubernetes, cloud firewalls
   - Impact: Works seamlessly in modern infrastructure

5. FLEXIBLE ENFORCEMENT
   - Fail2ban: Directly tied to iptables/nftables
   - CrowdSec: Bouncer system (iptables, nginx, cloud APIs)
   - Impact: Ban at any level from single detection

6. COMMUNITY HUB
   - Fail2ban: Manual configuration, community filters limited
   - CrowdSec: 500+ pre-built scenarios, parsers, collections
   - Impact: Less config time, more protection out of the box

7. FALSE POSITIVE REDUCTION
   - Fail2ban: Manual tuning required
   - CrowdSec: Community-validated scenarios, IP reputation
   - Impact: Fewer legitimate users accidentally banned

Real-World Example:

Fail2ban: Attacker probes -> Log written -> Regex matches -> Ban
  (Detection AFTER the fact, only on your server)

CrowdSec: Pattern detected -> IP reputation check -> Instant ban
  -> Share with community -> All users protected
  (Detection DURING attack, global protection)

For OpenClaw: CrowdSec means your agents benefit from global
threat intelligence, not just local log parsing.

Learn more: https://www.crowdsec.net/why-crowdsec
EOF
}

